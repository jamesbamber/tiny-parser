cabal-version:      3.14
name:               tiny-parser
version:            0.1.0.0
homepage:           https://github.com/jamesbamber/tiny-parser
license:            BSD-3-Clause
license-file:       LICENSE
author:             James Bamber
maintainer:         james.bamber.05@gmail.com
category:           Language
build-type:         Simple

extra-doc-files:
    CHANGELOG.md
    README.md

common extensions
    default-language: GHC2021

common ghc-options
    ghc-options: -Wall -Widentities

common rts-options
    ghc-options: -rtsopts -threaded "-with-rtsopts=-N"

library
    import:           extensions
    import:           ghc-options
    exposed-modules:
        Text.TinyParser.Core
        -- Text.TinyParser.Combinators
        -- Text.TinyParser.Char
        -- Text.TinyParser.Parsers.Expr
        -- Text.TinyParser.Parsers.Lambda
    build-depends:    base ^>=4.22.0.0
    hs-source-dirs:   src
    ghc-options:      -Wno-missing-home-modules
    default-language: GHC2024

test-suite tiny-parser-test
    import:           extensions
    import:           ghc-options
    import:           rts-options
    default-language: GHC2024
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    ghc-options:      -Wno-missing-home-modules
    main-is:          Main.hs
    build-depends:
        base ^>=4.22.0.0,
        tiny-parser
